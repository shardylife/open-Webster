# Copy to ~/assistant/config.env and fill in. Quotes and `export` are accepted.
OPENROUTER_API_KEY=sk-or-...
MODEL=anthropic/claude-haiku-4.5
TTS_MODEL=deepgram/aura-2
TTS_VOICE=aura-2-hyperion-en

# Optional overrides (defaults shown)
#STREAMING_AUDIO_ENABLED=1
#MIC_DEVICE=plughw:3,0
#OUT_DEVICE=_audioout
#WAKE_THRESHOLD=0.65
#SILENCE_RMS=350
